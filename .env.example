# ============================================================
# MR STEVE ENGLISH — VARIABLES D'ENVIRONNEMENT
# ============================================================
# Copier ces valeurs dans Vercel → Settings → Environment
# Variables (Production + Preview). Ce fichier est un MODÈLE :
# il ne contient AUCUN secret et reste versionné dans le dépôt.
# Les vraies valeurs (.env.local / variables Vercel) sont
# ignorées par .gitignore (.env*) — elles ne doivent JAMAIS
# être commitées.

# ------------------------------------------------------------
# META PIXEL — identifiant du pixel (PUBLIC)
# ------------------------------------------------------------
# Visible par nature dans le HTML de toutes les pages du site.
# Events Manager → Sources de données → le pixel → Paramètres.
# Si absent : repli automatique sur la valeur connue
# (1873557434014896) — le site trace dans tous les cas.
NEXT_PUBLIC_META_PIXEL_ID=1873557434014896

# ------------------------------------------------------------
# META CONVERSIONS API (CAPI) — token d'accès (SECRET !)
# ------------------------------------------------------------
# ⚠️ NE JAMAIS préfixer NEXT_PUBLIC_ : ce token doit rester
# côté SERVEUR uniquement (route /api/meta-conversions). Un
# token exposé permettrait à n'importe qui d'écrire des
# événements dans votre pixel.
# Génération : Events Manager → Sources de données → pixel →
# Paramètres → Conversions API → Générer un token d'accès.
# Tant qu'il n'est pas configuré, le site fonctionne
# normalement : seule la copie serveur des événements est
# désactivée (le pixel navigateur reste actif).
META_CAPI_ACCESS_TOKEN=
